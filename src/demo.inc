/* varsayilan gosterim programi */
    .ascii "// asmlang - dizgi, dizi, cop toplama\n"
    .ascii "tanim ad = \"dunya\"\n"
    .ascii "yazdir \"merhaba, \" + ad + \"!\"\n"
    .ascii "yazdir uzunluk(ad)\n"
    .ascii "yazdir \"a\" + \"b\" == \"ab\"\n"
    .ascii "tanim liste = [1, 2, 3]\n"
    .ascii "yazdir liste\n"
    .ascii "yazdir liste[1]\n"
    .ascii "liste[1] = 99\n"
    .ascii "ekle(liste, 42)\n"
    .ascii "ekle(liste, \"son\")\n"
    .ascii "yazdir liste\n"
    .ascii "yazdir uzunluk(liste)\n"
    .ascii "tanim ic = [[1,2],[3,4]]\n"
    .ascii "yazdir ic\n"
    .ascii "yazdir ic[1][0]\n"
    .ascii "yazdir \"sayi: \" + yazi(6 * 7)\n"
    .ascii "fonk topla(a, b) { d\303\266nd\303\274r a + b }\n"
    .ascii "yazdir topla(20, 22)\n"
    .ascii "fonk faktoryel(n) {\n"
    .ascii "    e\304\237er n <= 1 { d\303\266nd\303\274r 1 }\n"
    .ascii "    d\303\266nd\303\274r n * faktoryel(n - 1)\n"
    .ascii "}\n"
    .ascii "yazdir faktoryel(5)\n"
    .ascii "// cop toplama zorlamasi: 3000 gecici dizgi\n"
    .ascii "tanim i = 0\n"
    .ascii "iken i < 3000 { tanim cop = \"cop\" + yazi(i)  i = i + 1 }\n"
    .ascii "yazdir \"gc sonrasi hala saglam: \" + ad\n"
    .ascii "yazdir liste\n"
    .ascii "// --- girdi (bos stdin ile calisir) ---\n"
    .ascii "tanim satir = oku()\n"
    .ascii "e\304\237er satir == bos { yazdir \"girdi yok (EOF)\" } yoksa { yazdir \"okunan: \" + satir }\n"
    .ascii "// --- bayt tamponu ---\n"
    .ascii "tanim tb = tampon(4)\n"
    .ascii "tb[0] = 65  tb[1] = 83  tb[2] = 77\n"
    .ascii "yazdir tb\n"
    .ascii "yazdir uzunluk(tb)\n"
    .ascii "yazdir tb[1]\n"
